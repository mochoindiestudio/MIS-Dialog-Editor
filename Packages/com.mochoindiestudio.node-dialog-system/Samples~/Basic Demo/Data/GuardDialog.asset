  references:
    version: 2
    RefIds:
    - rid: 1954627727020523740
      type: {class: DialogNode, ns: MochoIndieStudio.DialogSystem, asm: MochoIndieStudio.DialogSystem}
      data:
        id: 7552686851dc4a8abce37faed451d625
        editorPosition: {x: 11, y: -154}
        mainText: Halt! I don't have all day, what do you need?
        responses:
        - responseText: Just passing through.
          targetNodeId: b693d8a1028e4114a15c29f8f3092614
          events: []
        - responseText: I heard you used to be an adventurer?
          targetNodeId: f5af4c4a9696408f9fe20a7850856b2c
          events: []
        - responseText: Have you seen any dragons?
          targetNodeId: d44e20ff447e4a56b7069f5b7860297b
          events: []
    - rid: 1954627727020523741
      type: {class: DialogNode, ns: MochoIndieStudio.DialogSystem, asm: MochoIndieStudio.DialogSystem}
      data:
        id: b693d8a1028e4114a15c29f8f3092614
        editorPosition: {x: 534, y: -419}
        mainText: Safe travels, then. Keep to the road.
        responses: []
    - rid: 1954627727020523742
      type: {class: DialogNode, ns: MochoIndieStudio.DialogSystem, asm: MochoIndieStudio.DialogSystem}
      data:
        id: f5af4c4a9696408f9fe20a7850856b2c
        editorPosition: {x: 534, y: -248}
        mainText: Aye, I used to be an adventurer like you, then I took an arrow
          in the knee. Now I stand watch here in Whiterun.
        responses:
        - responseText: Sounds rough. Glad you're safe now.
          targetNodeId: 59346ff1a12741348d1ba775aaa91cf9
          events:
          - eventId: guard_backstory_heard
            payload: 
    - rid: 1954627727020523743
      type: {class: DialogNode, ns: MochoIndieStudio.DialogSystem, asm: MochoIndieStudio.DialogSystem}
      data:
        id: 59346ff1a12741348d1ba775aaa91cf9
        editorPosition: {x: 1320, y: -248}
        mainText: Hope that knee heals up someday.
        responses: []
    - rid: 1954627727020523744
      type: {class: DialogNode, ns: MochoIndieStudio.DialogSystem, asm: MochoIndieStudio.DialogSystem}
      data:
        id: d44e20ff447e4a56b7069f5b7860297b
        editorPosition: {x: 534, y: -56}
        mainText: Dragons? Bah, tales for children... though the Jarl's been jumpy
          lately. Best ask him if you're curious.
        responses:
        - responseText: Understood. I'll ask around.
          targetNodeId: 3058b6794fc04245ba5fb2798aef0081
          events:
          - eventId: asked_about_dragons
            payload: 
    - rid: 1954627727020523745
      type: {class: DialogNode, ns: MochoIndieStudio.DialogSystem, asm: MochoIndieStudio.DialogSystem}
      data:
        id: 3058b6794fc04245ba5fb2798aef0081
        editorPosition: {x: 1320, y: -56}
        mainText: Stay safe out there.
        responses: []
